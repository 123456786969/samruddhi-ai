# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP_EMAIL and SMTP_PASSWORD: Required to send real OTP verification emails and admin notifications.
# If these are not provided, the server will simulate OTP sending and record alerts in memory/logs.
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# ADMIN_NOTIFICATION_EMAIL: Target email address for real-time alerts when users log in, onboard, or request demos.
# Defaults to rajubasavanahalli@gmail.com
ADMIN_NOTIFICATION_EMAIL="rajubasavanahalli@gmail.com"

# Meta WhatsApp Cloud API (Graph API v20.0)
# Configure these to deliver live WhatsApp messages directly to recipient numbers via Meta Cloud API.
# If not configured, the system uses the automated sandbox / simulation gateway.
WHATSAPP_API_TOKEN="EAAxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="100xxxxxxxxxxxx"
WHATSAPP_BUSINESS_ACCOUNT_ID="100xxxxxxxxxxxx"


# OTP_HMAC_SECRET: REQUIRED in production. Random string (32+ chars) used to HMAC login codes
# before they are stored. Generate with: openssl rand -hex 32
OTP_HMAC_SECRET="replace-with-a-long-random-string"

# Development only: set OTP_REQUIRED=false to skip the email-code step locally (ignored in production)
# OTP_REQUIRED="false"

# Razorpay (REQUIRED in production - the server refuses to take payments without them)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="replace-me"
# Webhook secret configured in Razorpay Dashboard > Webhooks. URL: https://YOUR-DOMAIN/api/billing/webhook
# Subscribe to: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET="replace-me"
